{
  "name": "positrontanks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @positrontanks/web build",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "test": "vitest run",
    "golden:update": "tsc -b && vitest run packages/engine-r1/src/golden.test.ts --mode update-goldens"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
